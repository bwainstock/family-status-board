# Synthetic fixture — NOT recorded from a real feed.
#
# The agent implementing worker/src/sources/ics.ts's recurrence support
# did not have access to a real Google Calendar "secret address in iCal
# format" URL (see #18, #19). This file is hand-authored to be
# *structurally* faithful to what Google Calendar's own export actually
# emits -- the PRODID, the X-WR-CALNAME/X-WR-TIMEZONE pair, the
# VTIMEZONE shape, and the DTSTART/RRULE/EXDATE/RECURRENCE-ID encodings
# below all match a real export -- but every name, uid, time and year of
# history in it is invented. A recorded fixture from a real feed, with
# personal detail scrubbed, remains an open acceptance item; see the
# issue for what to do once a real secret-address URL is available, and
# tools/record-fixtures.py for the pattern the ParentSquare feed already
# uses.
#
# Deliberately large -- a personal calendar's secret-address feed can
# carry years of one-off entries -- so that the CPU measurement in
# ics.bench.test.ts has something of a realistic size to measure
# against, and so the bounded-expansion code in rrule.ts has a series
# old enough (2015, 2018, 2019, 2020) to prove it does not walk.
#
# Verbatim below this line, apart from the CRLF line endings RFC 5545
# requires, which git and this repo's editors would otherwise strip.
BEGIN:VCALENDAR
PRODID:-//Google Inc//Google Calendar 70.9054//EN
VERSION:2.0
CALSCALE:GREGORIAN
METHOD:PUBLISH
X-WR-CALNAME:Household
X-WR-TIMEZONE:America/Los_Angeles
X-WR-CALDESC:Synthetic fixture calendar for the Family Status Board
BEGIN:VTIMEZONE
TZID:America/Los_Angeles
X-LIC-LOCATION:America/Los_Angeles
BEGIN:DAYLIGHT
TZOFFSETFROM:-0800
TZOFFSETTO:-0700
TZNAME:PDT
DTSTART:19700308T020000
RRULE:FREQ=YEARLY;BYMONTH=3;BYDAY=2SU
END:DAYLIGHT
BEGIN:STANDARD
TZOFFSETFROM:-0700
TZOFFSETTO:-0800
TZNAME:PST
DTSTART:19701101T020000
RRULE:FREQ=YEARLY;BYMONTH=11;BYDAY=1SU
END:STANDARD
END:VTIMEZONE
